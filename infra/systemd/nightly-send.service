[Unit]
Description=agent-ops nightly messages
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=agents
Group=agents
EnvironmentFile=/etc/agent-ops/env
Environment=AGENT_OPS_ENV=/etc/agent-ops/env
Environment=AGENT_OPS_ROOT=/srv/agent-ops
Environment=AGENT_LOG_ROOT=/var/log/agents
Environment=PATH=/home/agents/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/agent-ops/infra/bin/nightly-send.sh
TimeoutStartSec=3h
Nice=5
