# The service agents' env file on the agent host: ~/.config/agent-ops/env (macOS and Linux user
# installs) or /etc/agent-ops/env (Linux system install via bootstrap.sh), chmod 600. SETUP.md fills
# it; every secret is typed by you (hidden input), never pasted into a chat. Never commit real values.
# Names below follow routing.yaml: one CODEHOST_<KEY>_* block per `code_hosts` key (upper-cased).

# ---- Claude -----------------------------------------------------------------------------------
# A Claude plan login token (`claude setup-token`), or an API key from a Console workspace (then
# run-agent.sh ignores the token).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ---- Paths and public URLs --------------------------------------------------------------------
# the deployed checkout the agents run from
AGENT_OPS_ROOT=/srv/agent-ops
# read-only clones of the team's repos
AGENT_REPOS_DIR=/srv/repos
# e.g. https://agents.example.com/agent-mcp (people's plugins point here)
AGENT_MCP_PUBLIC_URL=

# ---- Service-agent cost and safety (run-agent.sh). All optional; defaults shown ----------------
# AGENT_MODEL_TRIAGE=sonnet
# AGENT_MODEL_RELEASE=sonnet
# AGENT_MODEL_ANALYST=opus
# AGENT_MODEL_NIGHTLY=sonnet
# AGENT_MODEL_JENKINS_WATCH=sonnet
# AGENT_MAX_TURNS_TRIAGE=80
# AGENT_MAX_TURNS_RELEASE=40
# AGENT_MAX_TURNS_ANALYST=150
# AGENT_MAX_TURNS_NIGHTLY=300
# AGENT_MAX_TURNS_JENKINS_WATCH=40
# Skip ticks once all service agents together spent this much (API prices) in the last 5 h; "off" disables.
# AGENT_BUDGET_5H_USD=60
# Pause an agent after this many failed runs in a row; probe again after the cool-off (seconds).
# AGENT_BREAKER_FAILS=3
# AGENT_BREAKER_COOLOFF_S=3600

# ---- Task board (tracker; routing.yaml `tracker:`, built in: plane) ---------------------------
# e.g. https://plane.example.com. If Plane runs on this same host, use http://127.0.0.1: the agents
# then keep working when the host's network address changes.
TRACKER_BASE_URL=
# the workspace slug
TRACKER_WORKSPACE=
# triage bot user (also used by the analyst and agent-mcp)
TRACKER_TRIAGE_TOKEN=
# release bot user
TRACKER_RELEASE_TOKEN=
# nightly bot user, or keep it in a file:
TRACKER_NIGHTLY_TOKEN=
# TRACKER_NIGHTLY_TOKEN_FILE=~/.config/agent-ops/tracker-nightly.token
# setup only (infra/plane/configure.sh); remove after setup
TRACKER_ADMIN_TOKEN=

# Instant triage (infra/macos/wake.py or the systemd agent-wake service on :8766): the shared secret
# n8n sends as X-Wake-Token. The same value goes into n8n's .env (infra/n8n/README.md).
WAKE_TOKEN=

# ---- Code hosts (routing.yaml `code_hosts:`; one block per key) --------------------------------
# API URLs come from routing.yaml (GitLab: <url>/api/v4; github.com: https://api.github.com;
# GitHub Enterprise: <url>/api/v3).
# read-only bot token (GitLab: read_api + read_repository; GitHub: contents/pull requests read)
CODEHOST_MAIN_TOKEN=
# release agent only: commit statuses and MR/PR notes
CODEHOST_MAIN_RELEASE_TOKEN=
CODEHOST_OSS_TOKEN=
CODEHOST_OSS_RELEASE_TOKEN=

# Action journal reverts: the revert tokens are NOT in this file (every service agent loads it).
# They live only in ~/.config/agent-ops/revert.env (chmod 600), read only by
# `infra/bin/journal revert-apply`: TRACKER_REVERT_TOKEN, CODEHOST_<KEY>_REVERT_TOKEN.

# ---- Read-only data sources (optional; agent_ro users) ----------------------------------------
PG_RO_URL=
CH_RO_HOST=
CH_RO_PORT=8443
CH_RO_SECURE=true
CH_RO_USER=agent_ro
CH_RO_PASSWORD=
# e.g. https://bi.example.com
METABASE_URL=
# view/query permissions only
METABASE_AGENT_API_KEY=
# Jenkins MCP endpoint (the Jenkins MCP Server plugin), e.g. https://ci.example.com/mcp-server/mcp
JENKINS_MCP_URL=
# Jenkins user with Overall/Read + Job/Read, no Build. The value has a space ("Basic <base64>"),
# so keep the quotes: this file is sourced by the shell.
JENKINS_RO_AUTH=""
# read-only personal access token
FIGMA_RO_TOKEN=

# ---- Notifications ----------------------------------------------------------------------------
# Private chats come from people.yaml `telegram_chat_id`, the team group from people.yaml
# `service.telegram_group_chat_id`. Alerts go privately to the question owner (routing.yaml).
TELEGRAM_BOT_TOKEN=
# Alerts (infra/bin/alert.sh): off = log alerts only
AGENT_ALERTS=on
# optional: send alerts to this chat instead of the question owner's private chat
# ALERT_CHAT_ID=
# Jenkins watcher (optional; infra/jenkins-watch/README.md): the group and forum topic it reads and
# posts in, and the bot's own username (its own messages are never alerts). Find the ids with
# `python3 infra/telegram/poll.py chats` after adding the bot to the group as an admin, with
# Bot-to-Bot Communication Mode on in @BotFather. Also needs JENKINS_MCP_URL and JENKINS_RO_AUTH.
TELEGRAM_WATCH_CHAT_ID=
TELEGRAM_WATCH_TOPIC_ID=
TELEGRAM_BOT_USERNAME=
# a build is stuck after this many times its usual duration, and at least this many minutes
# JENKINS_WATCH_STUCK_FACTOR=2
# JENKINS_WATCH_STUCK_MIN=30

# ---- Optional tuning --------------------------------------------------------------------------
# time zone of the nightly date and send time (default: the host's), e.g. Europe/Berlin
# NIGHTLY_TZ=
# boards the triage precheck reads (space-separated project keys; default: every projects.yaml key)
# TRIAGE_PROJECTS=
# review rules ignore state changes before this ISO time (useful right after adopting agent-ops)
# PRECHECK_RULES_SINCE=
# repo folders fetched without old file contents (large repos; space-separated names)
# AGENT_BLOBLESS_REPOS=
