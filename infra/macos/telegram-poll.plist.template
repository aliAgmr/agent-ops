<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd equivalent of infra/systemd/telegram-poll.service + telegram-poll.timer: runs
     infra/telegram/poll.py every minute and keeps the watched Telegram topic's messages for the
     Jenkins watcher. Rendered into ~/Library/LaunchAgents by infra/macos/install.sh when
     JENKINS_WATCH=true; __X__ are placeholders. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.telegram-poll</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/srv/agent-ops/infra/telegram/poll.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_OPS_ENV</key><string>__HOME__/.config/agent-ops/env</string>
    <key>AGENT_OPS_ROOT</key><string>/srv/agent-ops</string>
    <key>PATH</key><string>/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/agent-ops/telegram-poll/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/agent-ops/telegram-poll/launchd.err</string>
</dict>
</plist>
