<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd equivalent of infra/systemd/agent@.service + agent-<name>.timer.
     Rendered into ~/Library/LaunchAgents by infra/macos/install.sh; __X__ are placeholders. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.agent-__AGENT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/srv/agent-ops/infra/bin/run-agent.sh</string>
    <string>__AGENT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_OPS_ENV</key><string>__HOME__/.config/agent-ops/env</string>
    <key>AGENT_OPS_ROOT</key><string>/srv/agent-ops</string>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/agent-ops/__AGENT__/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/agent-ops/__AGENT__/launchd.err</string>
</dict>
</plist>
