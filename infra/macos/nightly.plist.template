<?xml version="1.0" encoding="UTF-8"?>
<!-- The nightly pass (infra/bin/nightly.sh). Times are the host's local time; install.sh fills
     __CALENDAR__ from NIGHTLY_AT / NIGHTLY_DAYS. Rendered when NIGHTLY=true; __X__ are placeholders. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/srv/agent-ops/infra/bin/nightly.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_OPS_ENV</key><string>__HOME__/.config/agent-ops/env</string>
    <key>AGENT_OPS_ROOT</key><string>/srv/agent-ops</string>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>__CALENDAR__</array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/agent-ops/nightly/nightly.out</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/agent-ops/nightly/nightly.err</string>
</dict>
</plist>
