{
  "mcpServers": {
    "plane": {
      "command": "uvx",
      "args": [
        "--from",
        "plane-mcp-server==0.3.4",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/scripts/plane-mcp-ce.py",
        "stdio"
      ],
      "env": {
        "PLANE_API_KEY": "${user_config.tracker_api_key}",
        "PLANE_BASE_URL": "${user_config.tracker_base_url}",
        "PLANE_WORKSPACE_SLUG": "${user_config.tracker_workspace_slug}"
      }
    },
    "agent-mcp": {
      "type": "http",
      "url": "${user_config.agent_mcp_url}/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.tracker_api_key}"
      }
    }
  }
}
