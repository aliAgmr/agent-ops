#!/bin/sh
# Refuse commits whose added lines look like a password or token.
if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' | grep -q -i -E -e '--password[ =][^ $<]' -e 'password *[:=] *["'\''][^"'\''$<]' -e 'Authorization: (Basic|Bearer) [A-Za-z0-9+/=_-]{12,}' -e 'gh[po]_[A-Za-z0-9]{20,}' -e 'glpat-[A-Za-z0-9_-]{16,}'; then
  echo "pre-commit: staged changes look like they contain a secret. Remove it, or commit with --no-verify if it's a false positive." >&2
  exit 1
fi
